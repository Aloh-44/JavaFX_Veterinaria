<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="540.0" prefWidth="768.0" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.javafx_veterinariasegundointento.HelloController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <ComboBox fx:id="cmbEspecie" onAction="#onEspecieChanged" prefWidth="150.0" promptText="Especie" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtEdad" promptText="Edad" />
            <TextField fx:id="txtPeso" promptText="Peso (kg)" />
            <TextField fx:id="txtCostoBase" promptText="Costo Base" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <TextField fx:id="txtRaza" promptText="Raza (solo perro)" />
            <CheckBox fx:id="chkVacunado" mnemonicParsing="false" text="Vacunado" />
            <CheckBox fx:id="chkIndoor" mnemonicParsing="false" text="Indoor" />
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onRegistrarClick" text="Registrar" />
            <Button mnemonicParsing="false" onAction="#onEliminarClick" text="Eliminar Seleccionado" />
         </children>
      </HBox>
      <Label fx:id="lblMensaje" />
      <TableView fx:id="tblMascotas" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colEspecie" prefWidth="75.0" text="Especie" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colPeso" prefWidth="75.0" text="Peso (kg)" />
            <TableColumn fx:id="colEdad" prefWidth="75.0" text="Edad" />
            <TableColumn fx:id="colDetalle" prefWidth="75.0" text="Detalle" />
            <TableColumn fx:id="colCostoBase" prefWidth="75.0" text="Costo Base" />
            <TableColumn fx:id="colCostoFinal" prefWidth="75.0" text="Costo Final" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
